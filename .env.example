# Frontend
# Public canonical origin for SEO. Vercel host is used when omitted.
SITE_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOMNIA_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_DREAMDEX_NETWORK=testnet

# Backend
PORT=4000
NODE_ENV=development
ENABLE_DEMO_SEED=false
MONGODB_URI=mongodb://localhost:27017/credence
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
SOMNIA_CHAIN_ID=50312
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
DREAMDEX_NETWORK=testnet
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
DREAMDEX_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
UNLOCK_TOKEN_ADDRESS=0x70a86d8842fb63c4ad2b7cdddf530ebf1bb25d8e
UNLOCK_TOKEN_SYMBOL=tUSDC
UNLOCK_TOKEN_DECIMALS=6
UNLOCK_PRICE_BASE_UNITS=1000000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required before paid unlocks are enabled; deploy contracts/src/InsightEscrow.sol on Shannon.
UNLOCK_ESCROW_ADDRESS=
PREDICTION_UNLOCK_BUFFER_SECONDS=60
DEMO_MIN_MARKET_REMAINING_SECONDS=900
ENABLE_AUTO_UNLOCK_REFUNDS=false
# Choose MONGODB_URI_DEV explicitly for a DEV database; defaults to MONGODB_URI.
MONGODB_CONNECTION_KEY=MONGODB_URI
MONGODB_URI_DEV=
REFUND_WORKER_PRIVATE_KEY=
UNLOCK_ESCROW_START_BLOCK=
REFUND_MAX_TX_COST_WEI=
